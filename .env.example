# Esteban Media — example environment variables.
# Copy to `.env.local` for dev. In production, set these in Vercel's project
# env (Settings → Environment Variables). `.env.local` is gitignored.

# Resend API key — used by app/api/contact/route.ts to send inquiries.
# Get one at https://resend.com/api-keys (free tier: 3k emails/month).
# If unset, the contact form returns 503 and the UI shows a "try again" toast.
RESEND_API_KEY=

# Inbox that receives contact form submissions.
# Falls back to gagui010@icloud.com (hardcoded in the route) when unset, so
# you only need to set this if you want to override.
CONTACT_TO_EMAIL=gagui010@icloud.com

# Note on the FROM address:
# The route currently sends from `onboarding@resend.dev` (Resend's sandbox
# sender) because Esteban's domain isn't verified yet. Swap to a verified
# domain in `app/api/contact/route.ts` once DNS is live.
