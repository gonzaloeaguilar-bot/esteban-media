{
  "name": "esteban-media",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=20.9 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "ga4:provision": "node scripts/ga4-provision.mjs",
    "index-watch:dry-run": "node scripts/search-console-index-watch.mjs dry-run",
    "index-watch:run": "node scripts/search-console-index-watch.mjs run",
    "index-watch:status": "node scripts/search-console-index-watch.mjs status",
    "seo:measurement:dry-run": "node scripts/esteban-seo-measurement-report.mjs dry-run",
    "seo:measurement:run": "node scripts/esteban-seo-measurement-report.mjs run",
    "seo:measurement:status": "node scripts/esteban-seo-measurement-report.mjs status",
    "seo:capture-score": "node scripts/free-capture-score.mjs report",
    "seo:free-discovery": "node scripts/free-opportunity-discovery.mjs",
    "weekly-digest:dry-run": "node scripts/esteban-media-weekly-digest.mjs dry-run",
    "weekly-digest:run": "node scripts/esteban-media-weekly-digest.mjs run",
    "weekly-digest:status": "node scripts/esteban-media-weekly-digest.mjs status",
    "demand-farm:dry-run": "node scripts/esteban-demand-content-farm.mjs dry-run",
    "demand-farm:run": "node scripts/esteban-demand-content-farm.mjs",
    "cta-dashboard": "node scripts/service-cta-dashboard.mjs",
    "seo:verify": "node scripts/verify-technical-seo.mjs",
    "seo:verify:local": "node scripts/verify-technical-seo.mjs http://localhost:3000",
    "seo:crawler-availability": "node scripts/crawler-availability.mjs",
    "seo:indexnow:dry-run": "node scripts/indexnow-submit.mjs dry-run",
    "seo:indexnow:run": "node scripts/indexnow-submit.mjs run",
    "seo:indexnow:status": "node scripts/indexnow-submit.mjs status",
    "search-tools:readiness": "node scripts/search-tool-readiness.mjs",
    "search-tools:readiness:json": "node scripts/search-tool-readiness.mjs --json",
    "reviews:sync": "node scripts/sync-google-reviews.mjs",
    "check": "pnpm rail-kit:check && pnpm rail-adoption:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm text-parity && python3 scripts/verify-spanish-hub-indexability.py .next/server/app",
    "rail-kit:check": "node scripts/sync-rail-kit.mjs --check",
    "rail-adoption:check": "vitest run app/__tests__/rail-adoption.test.ts",
    "followups": "node scripts/followup-due.mjs",
    "lead-desk:run": "node --experimental-strip-types --no-warnings scripts/run-lead-desk.ts",
    "events:check": "node --experimental-strip-types --no-warnings scripts/events-check.mjs",
    "text-parity": "node scripts/text-parity.mjs check .next/server/app app/__tests__/fixtures/spanish-niche-text-baseline.json",
    "lastmod:update": "PAGE_LASTMOD_UPDATE=1 vitest run app/__tests__/page-lastmod.test.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.14.0",
    "next": "15.5.18",
    "react": "19.1.2",
    "react-dom": "19.1.2",
    "shadcn": "^4.7.0",
    "tailwind-merge": "^3.6.0",
    "three": "^0.170.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "eslint": "^9",
    "eslint-config-next": "15.5.18",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^2.1.9"
  }
}
